---
import "@fontsource-variable/fira-code";

interface Props {
	title: string;
  description: string;
}

const { title, description } = Astro.props;

// Normalizar base: siempre empieza con / y termina con /
let base = import.meta.env.BASE_URL || '/';
if (!base.startsWith('/')) base = '/' + base;
if (!base.endsWith('/')) base = base + '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
    <meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
    <div class="blueprint-grid fixed inset-0 -z-10 h-full w-full"></div>
    <div class="content">
          <slot />
    </div>
	</body>
</html>
<style is:global>
    :root {
        color-scheme: dark;
    }
    html {
      font-family: "Fira Code Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
    }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background-color: #0a0f1e;
  }

  .blueprint-grid {
    background-color: #0a0f1e;
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(34, 211, 238, 0.12) 0,
        rgba(34, 211, 238, 0.12) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(34, 211, 238, 0.12) 0,
        rgba(34, 211, 238, 0.12) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        to right,
        rgba(34, 211, 238, 0.06) 0,
        rgba(34, 211, 238, 0.06) 1px,
        transparent 1px,
        transparent 32px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(34, 211, 238, 0.06) 0,
        rgba(34, 211, 238, 0.06) 1px,
        transparent 1px,
        transparent 32px
      );
  }

  .content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    html{
      scroll-behavior: auto;
    }
  }

</style>
